# Version lock for the Fabric experiment environment.
# Source this file from the deployment scripts:
#   source blockchain/fabric/network/version-lock.env
# Changing a value requires updating the README dependency table as well.

# Hyperledger Fabric
FABRIC_VERSION=2.5.7
FABRIC_CA_VERSION=1.5.12
FABRIC_GATEWAY_GO_VERSION=v1.8.0
CHAINCODE_LANGUAGE=go
CHAINCODE_DEPLOY_MODE=ccaas

# Toolchain
GO_VERSION=1.25.7
CALIPER_VERSION=0.7.1

# Node.js runtime for Caliper (caliper-cli 0.7.1 declares engines.node >= 22)
NODE_CALIPER_REQUIRED=">=22 (npm >=11.5.1)"

# test-network topology and ports
NAMESPACE=fabric
ORDERER_PORT=7050
ORDERER_TLS_HOSTNAME=orderer.example.com
PEER0_ORG1_PORT=7051
PEER0_ORG2_PORT=9051
CHANNEL_NAME=mychannel
CCAAS_SERVER_PORT=9999
CCAAS_ADDRESS=c5bc-ccaas:9999
DOCKER_NETWORK=fabric_test
FABRIC_SAMPLES_REF=main
